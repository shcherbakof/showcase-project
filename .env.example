# Project naming
COMPOSE_PROJECT_NAME=works_on_russia

# Timezone/locale
TZ=Europe/Moscow
LANG=C.UTF-8
LC_ALL=C.UTF-8

# Postgres image and host port
POSTGRES_IMAGE_TAG=16
POSTGRES_HOST_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASS=postgres
POSTGRES_PGDATA=/var/lib/postgresql/data/pgdata
POSTGRES_LOCALE=C.UTF-8
POSTGRES_ENCODING=UTF8

# Database names and users
PROJECT_DB=project_db
AIRFLOW_DB=airflow_db
SUPERSET_DB=superset_db
PROJECT_USER=project_user
AIRFLOW_USER=airflow_user
SUPERSET_USER=superset_user
PROJECT_PASS=project_pass
AIRFLOW_PASS=airflow_pass
SUPERSET_PASS=superset_pass

# db-init behavior
DB_SEED_ENABLED=1
DB_INIT_MODE=full-init

# Airflow
AIRFLOW_IMAGE_TAG=2.10.5-python3.11
AIRFLOW_HOST_PORT=8080
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Superset
SUPERSET_IMAGE_TAG=4.1.1
SUPERSET_HOST_PORT=8088
SUPERSET_SECRET_KEY=super-secret-key-for-local-demo
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_FIRSTNAME=Admin
SUPERSET_ADMIN_LASTNAME=User
SUPERSET_ADMIN_EMAIL=admin@example.com
